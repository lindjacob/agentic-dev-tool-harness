#!/usr/bin/env bash
set -euo pipefail
# create-item — provider verb (GitHub). Create a tracker item.
# Passes flags through to `gh issue create`. Maps the provider-agnostic --group
# to GitHub's --milestone; everything else (--title, --body-file, --label, ...) passes through.

args=()
while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --group)
      args+=(--milestone "$2")
      shift 2
      ;;
    --group=*)
      args+=(--milestone "${1#--group=}")
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

exec gh issue create "${args[@]}"
